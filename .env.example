# Postgres connection string
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/controversy_scanner

# Anthropic API key for the detection pipeline's Claude pass
ANTHROPIC_API_KEY=sk-ant-...

# Claude model used for the detection pass
CLAUDE_MODEL=claude-opus-5

# CORS-allowed origins for the future web dashboard (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000
